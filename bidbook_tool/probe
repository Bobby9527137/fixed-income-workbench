MARGIN_RE = re.compile(r"(?:目前|最终)边际([^，；。【]+)")
FULL_RE = re.compile(r"全场倍数([^，；。【]+)")
EDGE_RE = re.compile(r"边际倍数([^，；。【]+)")
SLOT_KEYS = ("margin", "full", "edge")
SLOT_NAMES = {"margin": "边际利率", "full": "全场倍数", "edge": "边际倍数"}


def slots_of(line):
    out = {}
    for key, pat in (("margin", MARGIN_RE), ("full", FULL_RE), ("edge", EDGE_RE)):
        m = pat.search(line or "")
        out[key] = m.group(1).strip().rstrip("。 ") if m else None
    return out


def slot_num(value):
    if value is None:
        return None
    m = re.match(r"^(\d+(?:\.\d+)?)\s*[%倍]?$", str(value).strip())
    return float(m.group(1)) if m else None


def free_port():
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = int(sock.getsockname()[1])
    sock.close()
    return port


def wait_port(port, timeout=90.0):
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=1.0):
                return True
        except OSError:
            time.sleep(0.3)
    return False


def http_post(url, payload, timeout=60.0):
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data,
                                 headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode("utf-8", "replace")


def as_json(text):
    try:
        return json.loads(text)
    except ValueError:
        return None


def verdict_of(checks):
    if any(v == "fail" for _, v, _ in checks):
        return "FAIL"
    if any(v == "diff" for _, v, _ in checks):
        return "DIFF"
    return "PASS"


def run_case(c, base):
    payload = {"text": c["text"], "values_text": c.get("values_text", ""),
               "default_time": "current", "rows": c.get("rows", [])}
    if c.get("threshold") is not None:
        payload["threshold"] = c["threshold"]
    status, txt = http_post(base + "/api/build", payload)
    body = as_json(txt)
    checks = []
    result = {"case": c, "payload": payload, "status": status, "body": body, "checks": checks}

    if c.get("status_400"):
        ok = (status == 400 and isinstance(body, dict) and body.get("ok") is False
              and "没有解析到" in str(body.get("error")))
        checks.append(("A10 不崩溃（优雅报错）", "ok" if ok else "fail",
                       "HTTP %s %s" % (status, txt[:200])))
        result["verdict"] = verdict_of(checks)
        return result

    if status != 200 or not isinstance(body, dict) or not body.get("ok"):
        checks.append(("A10 不崩溃（接口正常返回）", "fail", "HTTP %s %s" % (status, txt[:300])))
        result["verdict"] = verdict_of(checks)
        return result
    checks.append(("A10 不崩溃（接口正常返回）", "ok", ""))

    results = body.get("results") or []
    want = len([x for x in c["text"].split(NL) if "【" in x])
    lines = [x for x in str(body.get("text") or "").split(NL) if x.strip()]
    ok1 = len(results) == want and body.get("count") == want and len(lines) == want
    checks.append(("A1 行数守恒（输入 %d 只 → 输出 %d 行）" % (want, want),
                   "ok" if ok1 else "fail",
                   "results=%d count=%s text_lines=%d" % (len(results), body.get("count"), len(lines))))

    slots = [slots_of(r.get("line")) for r in results]

    bad2 = []
    for i, r in enumerate(results):
        if r.get("table") is None and not r.get("text_values"):
            s = slots[i]
            if any(s.get(k) != "待定" for k in SLOT_KEYS):
                bad2.append("第%d行 应全待定，实际 %s" % (i + 1, json.dumps(s, ensure_ascii=False)))
            if any(slot_num(s.get(k)) is not None for k in SLOT_KEYS):
                bad2.append("第%d行 出现了数字 %s" % (i + 1, json.dumps(s, ensure_ascii=False)))
    checks.append(("A2 两个来源都没数 → 三项全待定", "ok" if not bad2 else "fail", "；".join(bad2)))

    if c.get("values") is not None:
        bad5 = []
        for i, exp in c["values"].items():
            s = slots[i]
            for key in SLOT_KEYS:
                if key not in exp:
                    continue
                want_v = exp[key]
                got = s.get(key)
                if want_v is None:
                    if got != "待定":
                        bad5.append("第%d行 %s 期望「待定」，实际「%s」" % (i + 1, SLOT_NAMES[key], got))
                else:
                    gv = slot_num(got)
                    if gv is None or abs(gv - float(want_v)) > 0.001:
                        bad5.append("第%d行 %s 期望 %.2f，实际「%s」" % (i + 1, SLOT_NAMES[key], want_v, got))
        checks.append(("A5 期望数值（含范围取上限）", "ok" if not bad5 else "fail", "；".join(bad5)))

    if c.get("if_matched"):
        bad9 = []
        for i, spec in c["if_matched"].items():
            r = results[i]
            table = r.get("table")
            if table is None:
                s = slots[i]
                if any(s.get(k) != "待定" for k in SLOT_KEYS):
                    bad9.append("第%d行 判定没配上，却出了数 %s" % (i + 1, json.dumps(s, ensure_ascii=False)))
            else:
                if table.get("name") != spec.get("name"):
                    bad9.append("第%d行 配到「%s」，期望「%s」" % (i + 1, table.get("name"), spec.get("name")))
                for key, want_v in (spec.get("values") or {}).items():
                    gv = slot_num(slots[i].get(key))
                    if gv is None or abs(gv - float(want_v)) > 0.001:
                        bad9.append("第%d行 %s 期望 %.2f，实际「%s」"
                                    % (i + 1, SLOT_NAMES[key], want_v, slots[i].get(key)))
        checks.append(("A9 模糊简称：配上就必须是同一只（否则全待定）", "ok" if not bad9 else "fail", "；".join(bad9)))

    bad3 = []
    for row_idx, d in (c.get("dates") or []):
        nums = [float(n) for n in re.findall(r"\d+", str(d))]
        s = slots[row_idx]
        for key in SLOT_KEYS:
            n = slot_num(s.get(key))
            if n is not None and any(abs(n - x) < 0.001 for x in nums):
                bad3.append("第%d行 %s=「%s」像把日期 %s 当成了数值" % (row_idx + 1, SLOT_NAMES[key], s.get(key), d))
    checks.append(("A3 DD-DD 日期不得解析成利率/倍数", "ok" if not bad3 else "fail", "；".join(bad3)))

    bad7 = []
    for row_idx, vals in (c.get("forbid") or {}).items():
        s = slots[row_idx]
        for key in SLOT_KEYS:
            n = slot_num(s.get(key))
            if n is not None and any(abs(n - float(v)) < 0.001 for v in vals):
                bad7.append("第%d行 %s=「%s」疑似抄了别的债的数（禁止 %s）"
                            % (row_idx + 1, SLOT_NAMES[key], s.get(key),
                               "、".join("%g" % v for v in vals)))
    checks.append(("A7 不跨债券拷贝数据", "ok" if not bad7 else "fail", "；".join(bad7)))

    if c.get("blacklist"):
        bad4 = []
        if not body.get("values_rejected"):
            bad4.append("values_rejected 为空（没识别出黑名单词）")
        if body.get("value_count") != 0:
            bad4.append("窗口2 仍有 value_count=%s" % body.get("value_count"))
        if not body.get("values_error"):
            bad4.append("values_error 为空（网页没法弹窗）")
        for i, r in enumerate(results):
            if "文本" in str(r.get("values_source") or ""):
                bad4.append("第%d行 values_source=「%s」说明窗口2 还是被用了" % (i + 1, r.get("values_source")))
        checks.append(("A4 窗口2 命中黑名单 → 整段忽略", "ok" if not bad4 else "fail", "；".join(bad4)))

    if c.get("value_count") is not None:
        got = body.get("value_count")
        checks.append(("A11 窗口2 解析计数", "ok" if got == c["value_count"] else "fail",
                       "期望 %s，实际 %s" % (c["value_count"], got)))
    if c.get("pending_count") is not None:
        got = body.get("pending_count")
        checks.append(("A12 待定行数统计", "ok" if got == c["pending_count"] else "fail",
                       "期望 %s，实际 %s" % (c["pending_count"], got)))
    if c.get("no_data_count") is not None:
        got = body.get("no_data_count")
        checks.append(("A13 无数据行数统计", "ok" if got == c["no_data_count"] else "fail",
                       "期望 %s，实际 %s" % (c["no_data_count"], got)))

    bad8, diff8 = [], []
    for i, r in enumerate(results):
        line = str(r.get("line") or "")
        if "【来源：" not in line:
            bad8.append("第%d行 没有【来源：】标记" % (i + 1))
        if r.get("table") is not None:
            score = float(r.get("match_score") or 0.0)
        elif r.get("text_values"):
            score = float(r.get("values_score") or 0.0)
        else:
            score = 0.0
        if score > 0 and "匹配度" not in line:
            bad8.append("第%d行 没显示匹配分数（score=%.2f）" % (i + 1, score))
        if score <= 0 and "匹配度" not in line:
            diff8.append("第%d行 完全没配上：只写了「未匹配」，没给最相似标的与匹配分数（铁律8 要求携带匹配分数）"
                         % (i + 1))
    for tok in c.get("source") or []:
        if tok not in str(body.get("text") or ""):
            bad8.append("文案里缺少来源标记「%s」" % tok)
    checks.append(("A8 来源标记与匹配分数", "ok" if not bad8 else "fail", "；".join(bad8)))
    if diff8:
        checks.append(("A8b 零分行是否展示分数（口径差异）", "diff", "；".join(diff8)))

    bad6, diff6 = [], []
    for i, r in enumerate(results):
        line = str(r.get("line") or "")
        has_warn = "⚠" in line
        if r.get("table") is not None:
            score = float(r.get("match_score") or 0.0)
            if 0 < score < 0.90 and not has_warn:
                bad6.append("第%d行 匹配度 %.2f <0.90 却没有 ⚠" % (i + 1, score))
            if score >= 0.90 and has_warn:
                bad6.append("第%d行 匹配度 %.2f ≥0.90 却带了 ⚠" % (i + 1, score))
        elif r.get("text_values"):
            score = float(r.get("values_score") or 0.0)
            if 0 < score < 0.90 and not has_warn:
                bad6.append("第%d行 窗口2 匹配度 %.2f <0.90 却没有 ⚠" % (i + 1, score))
        else:
            if not has_warn:
                diff6.append("第%d行 没有任何候选（分数 0.00）：按铁律5/8 的严格口径应出 ⚠，实际只有「未匹配」"
                             % (i + 1))
    if c.get("warn") is True:
        for i, r in enumerate(results):
            if "⚠" not in str(r.get("line") or ""):
                bad6.append("第%d行 期望有 ⚠，实际没有" % (i + 1))
    if c.get("warn") is False:
        for i, r in enumerate(results):
            if "⚠" in str(r.get("line") or ""):
                bad6.append("第%d行 不该有 ⚠（匹配度 1.00）" % (i + 1))
    checks.append(("A6 ⚠ 告警口径（分数 <0.90 时应出现）", "ok" if not bad6 else "fail", "；".join(bad6)))
    if diff6:
        checks.append(("A6b 零分行的 ⚠（口径差异）", "diff", "；".join(diff6)))

    result["verdict"] = verdict_of(checks)
    return result


def excerpt(body, results):
    if not isinstance(body, dict):
        return body
    return {
        "count": body.get("count"), "pending_count": body.get("pending_count"),
        "no_data_count": body.get("no_data_count"), "review_count": body.get("review_count"),
        "value_count": body.get("value_count"), "values_rejected": body.get("values_rejected"),
        "values_error": body.get("values_error"), "value_problems": body.get("value_problems"),
        "results": [{
            "input_name": (r.get("input") or {}).get("name"),
            "table_name": (r.get("table") or {}).get("name"),
            "match_score": r.get("match_score"), "values_score": r.get("values_score"),
            "text_values": r.get("text_values"), "values_source": r.get("values_source"),
            "pending": r.get("pending"), "has_data": r.get("has_data"),
            "review_reason": r.get("review_reason"), "line": r.get("line"),
        } for r in results],
    }


def brief(c):
    rows = c.get("rows")
    rows_txt = ("%d 行表格" % len(rows)) if isinstance(rows, list) else str(rows)
    return {"id": c["cid"], "group": c["group"], "title": c["title"], "rules": c.get("rules", ""),
            "text": c["text"], "values_text": c.get("values_text", ""), "rows": rows_txt,
            "threshold": (c.get("threshold") if c.get("threshold") is not None else "默认 0.90"),
            "note": c.get("note", "")}


# --------------------------------------------------------------------------- #
# 主流程 / 报告
# --------------------------------------------------------------------------- #

def main():
    port = free_port()
    base = "http://127.0.0.1:%d" % port
    env = dict(os.environ)
    env["PYTHONIOENCODING"] = "utf-8"
    tmpdir = Path(tempfile.mkdtemp(prefix="bidbook_probe_"))
    log = tmpdir / "server.log"
    print("[*] 启动服务 %s（cwd=%s）" % (base, ROOT))
    with open(str(log), "wb") as fh:
        proc = subprocess.Popen(
            [sys.executable, "-u", "app.py", "--host", "127.0.0.1", "--port", str(port),
             "--no-browser", "--no-warmup"],
            cwd=str(ROOT), env=env, stdout=fh, stderr=subprocess.STDOUT,
        )
    if not wait_port(port):
        print("[!] 服务没起来，日志尾部：")
        try:
            print(log.read_text(encoding="utf-8", errors="replace")[-3000:])
        except OSError:
            pass
        proc.terminate()
        for _ in range(10):
            shutil.rmtree(str(tmpdir), ignore_errors=True)
            if not tmpdir.exists():
                break
            time.sleep(0.3)
        return 2
    print("[*] 服务就绪，开始跑 %d 个 case" % len(CASES))
    outcomes = []
    try:
        for c in CASES:
            r = run_case(c, base)
            outcomes.append(r)
            print("  %-4s %-5s %s" % (r["case"]["cid"], r["verdict"], r["case"]["title"]))
            for name, v, detail in r["checks"]:
                if v != "ok":
                    print("        %-4s %s%s" % (v.upper(), name, ("  -> " + detail) if detail else ""))
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
        # Windows：刚 terminate 的子进程还会短暂占着继承过去的日志句柄，重试才删得掉
        for _ in range(10):
            shutil.rmtree(str(tmpdir), ignore_errors=True)
            if not tmpdir.exists():
                break
            time.sleep(0.3)

    n_pass = sum(1 for r in outcomes if r["verdict"] == "PASS")
    n_diff = sum(1 for r in outcomes if r["verdict"] == "DIFF")
    n_fail = sum(1 for r in outcomes if r["verdict"] == "FAIL")
    print("[*] 汇总：PASS %d / 口径差异 %d / 铁律违反 %d（共 %d）" % (n_pass, n_diff, n_fail, len(outcomes)))
    write_report(outcomes, base, n_pass, n_diff, n_fail)
    print("[*] 报告：%s" % REPORT)
    return 1 if n_fail else 0


